# Qwen / DashScope native API endpoint.
LLM_URL=https://dashscope.aliyuncs.com/api/v1

# Replace this placeholder with your DashScope API key.
LLM_API_KEY=xxx

# Ollama embedding service. OLLAMA_HOST may be an http(s) URL or host:port.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# Embedded SeekDB data directory used by the paper vector index.
SEEKDB_DIR=data/vector/seekdb
SEEKDB_TABLE=paper_chunks

# Embedded PowerContext runtime data. It uses SQLite in the PaperBox backend
# process and does not expose a separate port.
POWERCONTEXT_DIR=data/powercontext
